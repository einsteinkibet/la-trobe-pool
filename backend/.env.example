# car-pool backend environment — copy to .env and fill in for production.

# Port the API listens on (host platforms usually set this for you).
PORT=3000

# Absolute path for the SQLite database file. Point this at a PERSISTENT disk on
# your host (not the ephemeral container FS) or data is lost on redeploy.
DB_PATH=/data/data.db

# Comma-separated list of allowed browser origins (your deployed frontend URL).
# REQUIRED for a public deploy — without it CORS allows all origins.
CORS_ORIGINS=https://your-frontend-domain.com

# ---- Payments (Stripe) ----
# Leave STRIPE_SECRET_KEY unset to run WITHOUT payments (wallet top-up/payout
# return 503; internal trip escrow still works off existing balances).
# Use a TEST key (sk_test_...) for dev; a live key (sk_live_...) only in prod.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (dev) or the Dashboard (prod).
# Optional but recommended; without it the redirect-confirm path still credits.
STRIPE_WEBHOOK_SECRET=
# Public base URL of the FRONTEND — Stripe Checkout/onboarding redirect back here.
APP_BASE_URL=http://localhost:5173
# Pricing (dollars). Fare = max(MIN_FARE, distanceKm * PRICE_PER_KM).
PRICE_PER_KM=0.5
MIN_FARE=3
PLATFORM_COMMISSION=0.1
CURRENCY=aud
